# Copy to .env.beta on the beta host. Use long random hexadecimal values for
# the passwords and console secret so they are safe to place in a PostgreSQL URL.
AUTHFORGE_DOMAIN=auth.example.com
POSTGRES_PASSWORD=replace-with-random-hex
AUTHFORGE_APP_PASSWORD=replace-with-different-random-hex
CONSOLE_TOKEN_SECRET=replace-with-at-least-32-random-bytes
SIGNING_SEED=replace-with-base64-encoded-32-random-bytes

# Use an SMTP provider with TLS/STARTTLS enabled and a verified sender domain.
SMTP_ADDR=smtp.example.com:587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=AuthForge <no-reply@example.com>

GOOGLE_CLIENT_ID=

# Optional: invite code to restrict developer console signup
CONSOLE_INVITE_CODE=
